{
  "name": "@weftcut/dsh-side-preview",
  "version": "0.1.0",
  "description": "WeftCut's side preview in a DeepSeek Harness right-sidebar tab, opened when the agent calls open_side_preview.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://weftcut.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeftCut/WeftCut.git",
    "directory": "plugins/dsh"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-tool"]
    }
  }
}
