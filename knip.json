{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Report an export only when it's used NOWHERE (truly dead). Exports that are
  // referenced within their own file are live-but-over-exposed — a style nit,
  // not dead code — so we don't flag them. Keeps the report to actionable signal.
  "ignoreExportsUsedInFile": true,
  // Throwaway prototypes, each run by hand on its own; nothing imports them.
  // The DeepSeek Harness bundle, whose files dsh loads from its package.json.
  "ignore": ["poc/**", "plugins/dsh/**"],
  // Host tools the scripts and tests spawn, not npm packages: the bundled or
  // system ffmpeg, the Go and C toolchains, and OS utilities.
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe",
    "go",
    "make",
    "otool",
    "install_name_tool",
    "objdump",
    "move",
    "tasklist",
    "xdg-open"
  ],
  // ffmpeg's own configure script, run by fetch-ffmpeg-lgpl.mjs in the unpacked
  // source tree.
  "ignoreUnresolved": ["./configure"],
  "workspaces": {
    "apps/desktop": {
      // The electron-vite plugin reads the build entries from
      // electron.vite.config.ts; these are the ones it cannot see.
      "entry": [
        // Built only under VITE_WEFTCUT_E2E.
        "src/main/calibration-host.ts",
        // The renderer pages' module scripts, named directly: their HTML
        // references them root-relative (`/main.tsx`), which knip resolves on
        // Linux but not on Windows, where every page then reads as unused.
        "src/renderer/main.tsx",
        "src/renderer/calibration/host.ts",
        "src/renderer/colorpick/desktopOverlay.ts",
        "src/renderer/public/render-play.html",
        "src/main/mcp/**/*.ts",
        "src/shared/motifs/builtin/**/*.{ts,html}",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": [
        // Reached only through `/// <reference types>` in vite-env.d.ts and
        // bench/tsconfig.json.
        "@webgpu/types",
        // JSDoc type import in stryker.config.mjs; ships with @stryker-mutator/core.
        "@stryker-mutator/api",
        // package-macos-release.test.mjs validates the release config with
        // electron-builder's own internals. They must be the copy
        // electron-builder resolves, so they stay its transitive dependencies
        // rather than separately pinned ones that could drift from it.
        "app-builder-lib",
        "builder-util"
      ]
    }
  }
}
