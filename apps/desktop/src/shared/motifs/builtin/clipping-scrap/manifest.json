{
  "id": "clipping-scrap",
  "name": "Clipping Scrap",
  "version": 1,
  "size": [
    720,
    300
  ],
  "default_duration_s": 5.0,
  "max_duration_prop": "duration_s",
  "settle_rafs": 1,
  "props_schema": {
    "duration_s": {
      "type": "number",
      "default": 5.0,
      "min": 0.5,
      "max": 600
    },
    "exit": {
      "type": "enum",
      "options": [
        "none",
        "lift",
        "fade",
        "slide_left",
        "slide_right",
        "slide_up",
        "slide_down"
      ],
      "default": "lift"
    },
    "kind": {
      "type": "enum",
      "options": [
        "newsprint",
        "torn",
        "tape"
      ],
      "default": "newsprint"
    },
    "tilt_deg": {
      "type": "number",
      "default": -5,
      "min": -12,
      "max": 12
    },
    "ink": {
      "type": "color",
      "default": "#16130F"
    },
    "paper": {
      "type": "color",
      "default": "#F2ECDF"
    },
    "font_body": {
      "type": "string",
      "default": "'Noto Serif', 'Source Serif 4', 'Georgia', 'Times New Roman', 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'SimSun', serif",
      "max_length": 200
    },
    "step_fps": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 30
    }
  }
}
