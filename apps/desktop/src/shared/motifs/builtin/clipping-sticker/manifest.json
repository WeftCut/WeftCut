{
  "id": "clipping-sticker",
  "name": "Clipping Sticker",
  "version": 1,
  "size": [
    900,
    760
  ],
  "default_duration_s": 5.0,
  "max_duration_prop": "duration_s",
  "settle_rafs": 1,
  "props_schema": {
    "duration_s": {
      "type": "number",
      "default": 5.0,
      "min": 0.5,
      "max": 600
    },
    "exit": {
      "type": "enum",
      "options": [
        "none",
        "lift",
        "fade",
        "slide_left",
        "slide_right",
        "slide_up",
        "slide_down"
      ],
      "default": "lift"
    },
    "photo": {
      "type": "media",
      "default": ""
    },
    "frame": {
      "type": "enum",
      "options": [
        "paper",
        "torn",
        "none"
      ],
      "default": "paper"
    },
    "tilt_deg": {
      "type": "number",
      "default": -3,
      "min": -15,
      "max": 15
    },
    "paper": {
      "type": "color",
      "default": "#F2ECDF"
    },
    "step_fps": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 30
    }
  }
}
