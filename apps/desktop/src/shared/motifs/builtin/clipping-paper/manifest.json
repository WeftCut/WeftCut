{
  "id": "clipping-paper",
  "name": "Clipping Paper",
  "version": 1,
  "size": [
    1920,
    1080
  ],
  "default_duration_s": 5.0,
  "content_duration_s": 0.1,
  "settle_rafs": 1,
  "graphic_role": "plate",
  "props_schema": {
    "ground": {
      "type": "enum",
      "options": [
        "kraft",
        "newsprint",
        "paper"
      ],
      "default": "kraft"
    },
    "ink": {
      "type": "color",
      "default": "#16130F"
    },
    "paper": {
      "type": "color",
      "default": "#F2ECDF"
    },
    "font_body": {
      "type": "string",
      "default": "'Noto Serif', 'Source Serif 4', 'Georgia', 'Times New Roman', 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'SimSun', serif",
      "max_length": 200
    }
  }
}
