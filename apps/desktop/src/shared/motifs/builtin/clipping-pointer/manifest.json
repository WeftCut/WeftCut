{
  "id": "clipping-pointer",
  "name": "Clipping Pointer",
  "version": 1,
  "size": [
    640,
    420
  ],
  "default_duration_s": 4.0,
  "max_duration_prop": "duration_s",
  "settle_rafs": 1,
  "graphic_role": "callout",
  "props_schema": {
    "duration_s": {
      "type": "number",
      "default": 4.0,
      "min": 0.5,
      "max": 600
    },
    "exit": {
      "type": "enum",
      "options": [
        "none",
        "lift",
        "fade",
        "slide_left",
        "slide_right",
        "slide_up",
        "slide_down"
      ],
      "default": "fade"
    },
    "kind": {
      "type": "enum",
      "options": [
        "arrow",
        "circle",
        "underline"
      ],
      "default": "arrow"
    },
    "label": {
      "type": "string",
      "default": "NEURON",
      "max_length": 30
    },
    "angle_deg": {
      "type": "number",
      "default": 0,
      "min": -180,
      "max": 180
    },
    "ink": {
      "type": "color",
      "default": "#16130F"
    },
    "paper": {
      "type": "color",
      "default": "#F2ECDF"
    },
    "accent": {
      "type": "color",
      "default": "#D2261C"
    },
    "font_headline": {
      "type": "string",
      "default": "'Anton', 'Bebas Neue', 'Impact', 'Arial Black', 'Noto Sans SC Black', 'Microsoft YaHei', sans-serif",
      "max_length": 200
    },
    "font_cjk": {
      "type": "string",
      "default": "'Noto Sans SC Black', 'Source Han Sans SC Heavy', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "max_length": 200
    },
    "step_fps": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 30
    }
  }
}
