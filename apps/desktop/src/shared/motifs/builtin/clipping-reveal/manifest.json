{
  "id": "clipping-reveal",
  "name": "Clipping Reveal",
  "version": 1,
  "size": [
    1200,
    460
  ],
  "default_duration_s": 5.0,
  "max_duration_prop": "duration_s",
  "settle_rafs": 1,
  "graphic_role": "callout",
  "props_schema": {
    "duration_s": {
      "type": "number",
      "default": 5.0,
      "min": 0.5,
      "max": 600
    },
    "exit": {
      "type": "enum",
      "options": [
        "none",
        "lift",
        "fade",
        "slide_left",
        "slide_right",
        "slide_up",
        "slide_down"
      ],
      "default": "lift"
    },
    "text": {
      "type": "string",
      "default": "HIPPOCAMPUS",
      "max_length": 24
    },
    "cue_tear_s": {
      "type": "number",
      "default": 1.2,
      "min": 0,
      "max": 600
    },
    "band": {
      "type": "enum",
      "options": [
        "red",
        "ink",
        "paper"
      ],
      "default": "red"
    },
    "cover": {
      "type": "enum",
      "options": [
        "newsprint",
        "kraft",
        "paper"
      ],
      "default": "newsprint"
    },
    "tilt_deg": {
      "type": "number",
      "default": -2,
      "min": -12,
      "max": 12
    },
    "ink": {
      "type": "color",
      "default": "#16130F"
    },
    "paper": {
      "type": "color",
      "default": "#F2ECDF"
    },
    "accent": {
      "type": "color",
      "default": "#D2261C"
    },
    "font_headline": {
      "type": "string",
      "default": "'Anton', 'Bebas Neue', 'Impact', 'Arial Black', 'Noto Sans SC Black', 'Microsoft YaHei', sans-serif",
      "max_length": 200
    },
    "font_cjk": {
      "type": "string",
      "default": "'Noto Sans SC Black', 'Source Han Sans SC Heavy', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "max_length": 200
    },
    "font_body": {
      "type": "string",
      "default": "'Noto Serif', 'Source Serif 4', 'Georgia', 'Times New Roman', 'Noto Serif SC', 'Source Han Serif SC', 'Songti SC', 'SimSun', serif",
      "max_length": 200
    },
    "step_fps": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 30
    }
  }
}
