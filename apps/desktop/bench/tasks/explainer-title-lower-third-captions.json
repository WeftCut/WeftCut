{
  "id": "explainer-title-lower-third-captions",
  "fixtures": ["explainer-memory"],
  "project": { "width": 1920, "height": 1080, "fps": { "num": 25, "den": 1 } },
  "setup": [
    { "tool": "import_media", "args": { "path": "{fixture:explainer-memory}" }, "as": "media" },
    { "tool": "read_project", "args": { "view": "tracks" }, "as": "tracks" },
    { "tool": "add_video_layer", "args": { "media_id": "{ref:media.media_id}", "track_id": "{ref:tracks[role=ARoll].id}", "src_in_us": 0, "src_out_us": 215200000, "t_start_us": 0, "t_end_us": 215200000 } }
  ],
  "prompt": "Make this lecture excerpt work as a standalone clip. Put a title on it at the beginning, add a lower third introducing the speaker as Dr. Lisa Genzel, neuroscientist at Radboud University, when she's first on camera, and caption the whole thing.",
  "checklist": [
    { "id": "title-at-start", "description": "A title (text or animated overlay, not a caption) appears within the first 2 s and holds at least 1.5 s", "check": { "kind": "layer_count", "op": ">=", "n": 1, "where": { "layer_kind": ["Text", "Motif"], "caption": false, "starts_before_s": 2, "min_duration_s": 1.5 } } },
    { "id": "lower-third-name", "description": "A non-caption overlay names her as Lisa Genzel", "check": { "kind": "text_layer_matching", "text_regex": "Lisa Genzel", "flags": "" } },
    { "id": "lower-third-affiliation", "description": "Her role or affiliation is on screen too", "check": { "kind": "text_layer_matching", "text_regex": "Radboud|neuroscien" } },
    { "id": "lower-third-timing", "description": "The name appears while she is first on camera (before 25 s) and stays up at least 3 s", "check": { "kind": "text_layer_matching", "text_regex": "Genzel", "where": { "starts_before_s": 25, "min_duration_s": 3 } } },
    { "id": "lower-third-placement", "description": "If the lower third is a text layer, it sits in the lower part of the frame", "check": { "kind": "layer_region", "where": { "layer_kind": ["Text", "Motif"], "caption": false, "text_regex": "Genzel" }, "y": [0.55, 1.0], "require": "any" } },
    { "id": "title-and-lower-third-separate", "description": "The title and the lower third are separate layers", "check": { "kind": "layer_count", "op": ">=", "n": 2, "where": { "layer_kind": ["Text", "Motif"], "caption": false } } },
    { "id": "captions-present", "description": "A caption track exists with a real number of cues", "check": { "kind": "caption_track_present", "min_cues": 30 } },
    { "id": "captions-cover", "description": "Captions run through the clip", "check": { "kind": "caption_coverage", "min_fraction": 0.7 } },
    { "id": "captions-on-picture", "description": "Every caption sits over footage", "check": { "kind": "captions_over_picture", "min_fraction": 1 } },
    { "id": "footage-intact", "description": "The lecture footage is all still there", "check": { "kind": "timeline_duration", "measure": "video", "min_s": 214.5 } },
    { "id": "caption-accuracy", "description": "Captions read correctly, including hippocampus and cortex", "check": { "kind": "human" } }
  ]
}
