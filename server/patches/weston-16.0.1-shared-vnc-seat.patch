 static void
+vnc_reset_peer_input(struct vnc_peer *peer)
+{
+	struct timespec time;
+	struct weston_key_event key_event;
+	struct weston_pointer_button_event button_event;
+	const uint32_t buttons[] = { BTN_LEFT, BTN_MIDDLE, BTN_RIGHT };
+	const unsigned int masks[] = { NVNC_BUTTON_LEFT, NVNC_BUTTON_MIDDLE, NVNC_BUTTON_RIGHT };
+	unsigned int key, i;
+	if (!peer)
+		return;
+	weston_compositor_get_time(&time);
+	for (key = 0; key < KEY_CNT; key++) {
+		if (peer->pressed_keys[key]) {
+			weston_key_event_init(&key_event, &time, peer->seat, key,
+				WL_KEYBOARD_KEY_STATE_RELEASED, STATE_UPDATE_AUTOMATIC);
+			notify_key(&key_event);
+		}
+		peer->pressed_keys[key] = false;
+	}
+	for (i = 0; i < ARRAY_LENGTH(buttons); i++) {
+		if (peer->last_button_mask & masks[i]) {
+			weston_pointer_button_event_init(&button_event, &time,
+				peer->seat, buttons[i], WL_POINTER_BUTTON_STATE_RELEASED);
+			notify_button(&button_event);
+		}
+	}
+	peer->last_button_mask = 0;
+	notify_pointer_frame(peer->seat);
+}
+
+static void
+vnc_activate_peer(struct vnc_peer *peer)
+{
+	if (!peer->backend->shared_seat || peer->backend->input_peer == peer)
+		return;
+	vnc_reset_peer_input(peer->backend->input_peer);
+	peer->backend->input_peer = peer;
+}
