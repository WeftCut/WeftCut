 static void
+vnc_reset_peer_input(struct vnc_peer *peer)
+{
+	struct timespec time;
+	unsigned int key;
+	if (!peer)
+		return;
+	weston_compositor_get_time(&time);
+	for (key = 0; key < KEY_CNT; key++) {
+		if (peer->pressed_keys[key])
+			notify_key(peer->seat, &time, key,
+				   WL_KEYBOARD_KEY_STATE_RELEASED,
+				   STATE_UPDATE_AUTOMATIC);
+		peer->pressed_keys[key] = false;
+	}
+	if (peer->last_button_mask & NVNC_BUTTON_LEFT)
+		notify_button(peer->seat, &time, BTN_LEFT, WL_POINTER_BUTTON_STATE_RELEASED);
+	if (peer->last_button_mask & NVNC_BUTTON_MIDDLE)
+		notify_button(peer->seat, &time, BTN_MIDDLE, WL_POINTER_BUTTON_STATE_RELEASED);
+	if (peer->last_button_mask & NVNC_BUTTON_RIGHT)
+		notify_button(peer->seat, &time, BTN_RIGHT, WL_POINTER_BUTTON_STATE_RELEASED);
+	peer->last_button_mask = 0;
+	notify_pointer_frame(peer->seat);
+}
+
+static void
+vnc_activate_peer(struct vnc_peer *peer)
+{
+	if (!peer->backend->shared_seat || peer->backend->input_peer == peer)
+		return;
+	vnc_reset_peer_input(peer->backend->input_peer);
+	peer->backend->input_peer = peer;
+}
